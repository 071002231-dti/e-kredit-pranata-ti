# =============================================================================
# E-Kredit Pranata TI - Production Environment
# =============================================================================
# Copy this file to .env and configure for your VPS (10.30.30.171)

# =============================================================================
# Application
# =============================================================================
APP_ENV=production
APP_DEBUG=false
APP_URL=http://10.30.30.171:8000
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate

# Ports (Main app: 8000, WhatsApp: 8080)
APP_PORT=8000
WHATSAPP_PORT=8080

# =============================================================================
# Main Database (e-kredit)
# =============================================================================
DB_DATABASE=e_kredit
DB_USERNAME=e_kredit
DB_PASSWORD=your_secure_database_password
DB_ROOT_PASSWORD=your_secure_root_password

# =============================================================================
# WhatsApp Service Database
# =============================================================================
WHATSAPP_DB_USERNAME=whatsapp
WHATSAPP_DB_PASSWORD=your_secure_whatsapp_db_password
WHATSAPP_DB_ROOT_PASSWORD=your_secure_whatsapp_root_password
WHATSAPP_APP_KEY=base64:GENERATE_ANOTHER_KEY_FOR_WHATSAPP

# =============================================================================
# Service Communication Keys
# =============================================================================
# These keys authenticate communication between services
# Generate with: openssl rand -base64 32

# Key for main app to call whatsapp-service
WHATSAPP_SERVICE_KEY=your_secure_whatsapp_service_key

# Key for whatsapp-service to call main app
INTERNAL_API_KEY=your_secure_internal_api_key

# =============================================================================
# WhatsApp Cloud API
# =============================================================================
# Get these from Meta Business Manager (https://business.facebook.com/)
# Leave empty if not using WhatsApp yet

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_WEBHOOK_SECRET=your_webhook_secret
