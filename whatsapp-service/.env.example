APP_NAME="WhatsApp Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=whatsapp-db
DB_PORT=3306
DB_DATABASE=whatsapp_db
DB_USERNAME=whatsapp
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis

# =============================================================================
# Main App Connection
# =============================================================================
# Configuration for connecting to the main e-kredit application

MAIN_APP_URL=http://app
MAIN_APP_INTERNAL_KEY=your-secure-internal-api-key

# =============================================================================
# WhatsApp Cloud API Configuration
# =============================================================================
# Get these credentials from Meta Business Manager (https://business.facebook.com/)

WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret
WHATSAPP_TIMEOUT=20

# =============================================================================
# Service Authentication
# =============================================================================
# API key for main app to call this service

SERVICE_API_KEY=your-secure-whatsapp-service-key

# =============================================================================
# WhatsApp Settings
# =============================================================================

WHATSAPP_LANGUAGE_CODE=id
WHATSAPP_QUEUE_ENABLED=true
WHATSAPP_RATE_LIMIT_ENABLED=true
WHATSAPP_RATE_LIMIT_MAX=1000
WHATSAPP_VERIFY_SIGNATURE=true
